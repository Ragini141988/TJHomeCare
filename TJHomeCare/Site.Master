<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="TJHomeCare.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">TJ Home Care</asp:ContentPlaceHolder></title>
    <meta name="description" content="Professional home care services in Bangalore by TJ Homecare." />
       <!-- WEBSITE FAVICON -->
    <link rel="icon" type="image/png"
          href="<%= ResolveUrl("~/favicon.ico") %>" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/Site.css") %>" />
    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-DMW7JFQ8XS"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-DMW7JFQ8XS');
</script>
    <style>
    .nav-wrap {
        display: flex !important;
        align-items: center;
        flex-wrap: wrap;
    }

    .nav-wrap .brand { margin-right: auto; }

    .nav-wrap .header-actions {
        display: flex !important;
        flex-direction: row;
        align-items: center;
        gap: 10px;
        margin-right: 12px;
    }

    .nav-wrap .header-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff !important;
        font-size: 18px;
        text-decoration: none;
    }

    .nav-wrap .call-icon { background: #0a6fe8; }
    .nav-wrap .wa-icon   { background: #25D366; font-size: 22px; }

    /* stop the toggle from overlapping the icons */
    .nav-wrap .menu-toggle {
        position: static !important;
        margin: 0 !important;
        flex: 0 0 auto;
    }

    /* keep the dropdown menu on its own full-width row */
    .nav-wrap .main-nav { flex: 0 0 100%; }
</style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
     <asp:ContentPlaceHolder ID="head" runat="server" />

</head>
<body>
<form id="mainForm" runat="server">

    <header class="site-header">
        <div class="container nav-wrap">
           <a class="brand" href="<%= ResolveUrl("~/HomePage.aspx") %>" aria-label="TJ Homecare Home">
    <img src="<%= ResolveUrl("~/Images/tjhomecare-logo.jpg") %>"
         alt="TJ Homecare"
         class="brand-logo" />
</a>
<div class="header-actions">
    <a href="tel:+919429693689" class="header-icon call-icon" aria-label="Call us">
        <i class="fa-solid fa-phone"></i>
    </a>
    <a href="https://wa.me/919429693689" target="_blank" rel="noopener" class="header-icon wa-icon" aria-label="Chat on WhatsApp">
        <i class="fa-brands fa-whatsapp"></i>
    </a>
    <button type="button" class="menu-toggle" aria-label="Open menu" onclick="toggleMenu()">
        <i class="fa-solid fa-bars"></i>
    </button>
</div>

            <nav id="mainNav" class="main-nav">
                <a href="<%= ResolveUrl("~/HomePage.aspx") %>">Home</a>
                <a href="<%= ResolveUrl("~/About.aspx") %>">About</a>
                <a href="<%= ResolveUrl("~/Contact.aspx") %>">Contact Us</a>
            </nav>
        </div>
    </header>

    <main>
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <div class="footer-brand">TJ HOMECARE</div>
                <p>Professional and compassionate home care services designed around the comfort, safety and individual needs of your loved ones.</p>
            </div>
            <div>
                <h4>Quick Links</h4>
                <a href="<%= ResolveUrl("~/HomePage.aspx") %>">Home</a>
                <a href="<%= ResolveUrl("~/About.aspx") %>">About</a>
                <a href="<%= ResolveUrl("~/Contact.aspx") %>">Contact Us</a>               
<a href="<%= ResolveUrl("~/PrivacyPolicy.aspx") %>">Privacy Policy</a>
<a href="<%= ResolveUrl("~/TermsAndConditions.aspx") %>">Terms &amp; Conditions</a>
<a href="<%= ResolveUrl("~/Pricing.aspx") %>">
    Pricing &amp; Service Charges
</a>
<a href="<%= ResolveUrl("~/CancellationRefundPolicy.aspx") %>">Cancellation &amp; Refund Policy</a>

            </div>
            <div>
                <h4>Home Care</h4>
                <span>Caregivers</span>
                <span>Patient Care</span>
                <span>Baby Care</span>
                <span>Home Nursing</span>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">© <%: DateTime.Now.Year %> TJ Homecare. All Rights Reserved.</div>
        </div>
    </footer>

</form>

<script>
    function toggleMenu() {
        document.getElementById('mainNav').classList.toggle('open');
    }
</script>
</body>
</html>
